<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>2.4.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/Icons/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <NativeRuntimeIdentifier>$(RuntimeIdentifier)</NativeRuntimeIdentifier>
    <NativeRuntimeIdentifier Condition="'$(NativeRuntimeIdentifier)' == '' And $([MSBuild]::IsOsPlatform('Linux'))">linux-x64</NativeRuntimeIdentifier>
    <NativeRuntimeIdentifier Condition="'$(NativeRuntimeIdentifier)' == '' And $([MSBuild]::IsOsPlatform('Windows'))">win-x64</NativeRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced libraries can be built without the application's RID. Select
         distributable native files here using the application's target. -->
    <None Include="../ApsGenerator.Solver/runtimes/$(NativeRuntimeIdentifier)/native/*"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia" Version="11.0.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Icons/icon.ico" />
    <AvaloniaResource Include="Assets/Icons/loader.png" Link="Resources/loader.png" />
    <AvaloniaResource Include="Assets/Icons/clip.png" Link="Resources/clip.png" />
    <AvaloniaResource Include="Assets/Icons/connector.png" Link="Resources/connector.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApsGenerator.Core\ApsGenerator.Core.csproj" />
    <ProjectReference Include="..\ApsGenerator.Solver\ApsGenerator.Solver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE.md"
          Link="LICENSE.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSES/*"
          Link="LICENSES/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../native/cryptominisat/LICENSE.txt"
          Link="LICENSES/CryptoMiniSat-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
